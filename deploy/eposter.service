[Unit]
Description=EPoster FastAPI backend
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/eposter
Environment=EPOSTER_DATA_DIR=/opt/eposter/data
ExecStart=/usr/bin/gunicorn -k uvicorn.workers.UvicornWorker -w 1 -b 0.0.0.0:8000 web_app:app
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
